{
  "//": "Answer-quality cases for the chat eval (Phase 5 runner: scripts/eval.ts, not written yet). Each answer must match every `mustMatch` regex and none of the `mustNotMatch` regexes, and each `maxCount` regex may occur at most that many times (all case-insensitive). Run with the cache bypassed and ≥ 6 s between questions. `previousQuestions` (optional) are asked first, in order, and their real answers become the conversation history; the checks apply to the answer to `question`.",
  "cases": [
    {
      "id": "start-date-without-visa",
      "question": "When can he start?",
      "grounded": true,
      "mustMatch": [
        "immediate"
      ],
      "mustNotMatch": [
        "visa",
        "sponsor",
        "work authori[sz]ation",
        "salary",
        "AED"
      ]
    },
    {
      "id": "notice-period-without-visa",
      "question": "What is his notice period?",
      "grounded": true,
      "mustMatch": [
        "notice period"
      ],
      "mustNotMatch": [
        "visa",
        "sponsor",
        "salary",
        "AED"
      ]
    },
    {
      "id": "visa-when-asked",
      "question": "Does he need visa sponsorship?",
      "grounded": true,
      "mustMatch": [
        "visit visa",
        "sponsor"
      ],
      "mustNotMatch": [
        "salary",
        "AED"
      ]
    },
    {
      "id": "chip-open-to-work",
      "question": "Is he open to work?",
      "grounded": true,
      "mustMatch": [
        "AI Engineer",
        "AI Automation Engineer",
        "Python Developer",
        "UAE|United Arab Emirates"
      ],
      "mustNotMatch": [
        "immediate",
        "notice period",
        "start date",
        "visa",
        "sponsor",
        "salary",
        "AED"
      ]
    },
    {
      "id": "chip-who-is-sheheen",
      "question": "Who is Sheheen?",
      "grounded": true,
      "mustMatch": [
        "AI engineer",
        "ICFOSS"
      ],
      "mustNotMatch": [
        "visa",
        "salary",
        "AED"
      ]
    },
    {
      "id": "full-name-at-most-once",
      "question": "What did he build at ICFOSS?",
      "grounded": true,
      "mustMatch": [
        "ICFOSS"
      ],
      "maxCount": {
        "Muhammed Sheheen M\\s*T\\s*P": 1
      }
    },
    {
      "id": "follow-up-starts-with-he",
      "previousQuestions": [
        "Can he automate workflows for my team?"
      ],
      "question": "When can he start?",
      "grounded": true,
      "mustMatch": [
        "^He\\b"
      ],
      "mustNotMatch": [
