    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/manjari": "^5.3.0",
    "@google/genai": "2.31.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.2.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "28.0.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:index": "node --disable-warning=ExperimentalWarning --env-file=.env --env-file-if-exists=.env.local scripts/build-index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "logs": "node --disable-warning=ExperimentalWarning --env-file=.env --env-file-if-exists=.env.local scripts/logs.ts"
  }
