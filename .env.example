# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API: chat (gemini-3.5-flash-lite, fallback gemini-3.1-flash-lite) and
# embeddings (gemini-embedding-2) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: rate limiting, answer cache and anonymous question log via Upstash Redis.
# The Vercel Marketplace integration names these KV_REST_API_URL / KV_REST_API_TOKEN;
# either pair works.
# Without these, the limiter is in-memory, the cache is off, and questions are logged
# to the function console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
